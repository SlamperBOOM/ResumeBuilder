{
    "edit_area": {
        "resume_name": {
            "type": "text_input",
            "title": "resume_name_title",
            "resume_value": "resume_name"
        },
        "resume_blocks": {
            "main_block": {
                "block_title": "main_block.title",
                "desired_position": {
                    "type": "text_input",
                    "title": "main_block.desired_position",
                    "resume_value": "MAIN_BLOCK.desired_position"
                },
                "last_name": {
                    "type": "text_input",
                    "title": "main_block.last_name",
                    "resume_value": "MAIN_BLOCK.last_name"
                },
                "first_name": {
                    "type": "text_input",
                    "title": "main_block.first_name",
                    "resume_value": "MAIN_BLOCK.first_name"
                },
                "date": {
                    "type": "date",
                    "fields": [
                        "day",
                        "month",
                        "year"
                    ],
                    "translations": "main_block.date_of_birth",
                    "resume_value": "MAIN_BLOCK.date_of_birth"
                },
                "city": {
                    "type": "text_input",
                    "title": "main_block.city",
                    "resume_value": "MAIN_BLOCK.city"
                },
                "desired_salary": {
                    "type": "text_input",
                    "title": "main_block.desired_salary",
                    "resume_value": "MAIN_BLOCK.desired_salary"
                },
                "occupation": {
                    "type": "text_input",
                    "title": "main_block.occupation",
                    "resume_value": "MAIN_BLOCK.occupation"
                },
                "employment": {
                    "type": "drop_down_list",
                    "title": "main_block.employment_title",
                    "values": {
                        "null": "",
                        "FULL_TIME": "main_block.employment.full_time",
                        "PART_TIME": "main_block.employment.part_time",
                        "PROJECT": "main_block.employment.project",
                        "VOLUNTEER": "main_block.employment.volunteer",
                        "INTERNSHIP": "main_block.employment.internship"
                    },
                    "resume_value": "MAIN_BLOCK.employment",
                    "default": "null"
                },
                "schedule": {
                    "type": "drop_down_list",
                    "title": "main_block.schedule_title",
                    "values": {
                        "null": "",
                        "FULL_TIME": "main_block.schedule.full_time",
                        "FLEXIBLE": "main_block.schedule.flexible",
                        "SHIFT": "main_block.schedule.shift",
                        "REMOTE": "main_block.schedule.remote",
                        "SHIFT_WATCH": "main_block.schedule.shift_watch"
                    },
                    "resume_value": "MAIN_BLOCK.schedule",
                    "default": "null"
                },
                "is_moving_acceptable": {
                    "type": "toggle",
                    "title": "main_block.is_moving_acceptable",
                    "resume_value": "MAIN_BLOCK.is_moving_acceptable",
                    "default": "false"
                },
                "is_ready_for_business_trips": {
                    "type": "toggle",
                    "title": "main_block.is_ready_for_business_trips",
                    "resume_value": "MAIN_BLOCK.is_ready_for_business_trips",
                    "default": "false"
                },
                "driving_license": {
                    "type": "text_input",
                    "title": "main_block.driving_license",
                    "resume_value": "MAIN_BLOCK.driving_license"
                },
                "marital_status": {
                    "type": "text_input",
                    "title": "main_block.marital_status",
                    "resume_value": "MAIN_BLOCK.marital_status"
                },
                "have_children": {
                    "type": "toggle",
                    "title": "main_block.have_children",
                    "resume_value": "MAIN_BLOCK.have_children",
                    "default": "false"
                },
                "goal_of_resume": {
                    "type": "text_input",
                    "title": "main_block.goal_of_resume",
                    "resume_value": "MAIN_BLOCK.goal_of_resume"
                }
            },
            "contacts": {
                "block_title": "contacts.title",
                "email": {
                    "type": "text_input",
                    "title": "contacts.email",
                    "resume_value": "CONTACTS.email"
                },
                "phone_number": {
                    "type": "text_input",
                    "title": "contacts.phone_number",
                    "resume_value": "CONTACTS.phone_number"
                },
                "social_nets": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "CONTACTS.social_nets",
                    "block_format": {
                        "social_net_name": {
                            "type": "text_input",
                            "title": "contacts.social_net_name",
                            "resume_value": "social_net_name"
                        },
                        "social_net_link": {
                            "type": "text_input",
                            "title": "contacts.social_net_link",
                            "resume_value": "social_net_profile_link"
                        }
                    },
                    "add_button_title": "contacts.add_social_net"
                }
            },
            "experience": {
                "block_title": "experience.title",
                "experiences": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "EXPERIENCE.experiences",
                    "block_format": {
                        "position": {
                            "type": "text_input",
                            "title": "experience.position",
                            "resume_value": ""
                        },
                        "company": {
                            "type": "text_input",
                            "title": "experience.company",
                            "resume_value": ""
                        },
                        "start_date": {
                            "type": "date",
                            "fields": [
                                "month",
                                "year"
                            ],
                            "translations": "experience.start_date",
                            "resume_value": "start_date"
                        },
                        "end_date": {
                            "type": "date",
                            "fields": [
                                "month",
                                "year"
                            ],
                            "translations": "experience.end_date",
                            "resume_value": "end_date"
                        },
                        "is_still_working": {
                            "type": "toggle",
                            "title": "experience.is_still_working",
                            "resume_value": "is_still_working",
                            "default": "false"
                        },
                        "work_description": {
                            "type": "text_area",
                            "title": "experience.work_description",
                            "resume_value": "work_description"
                        }
                    },
                    "add_button_title": "experience.add_experience"
                }
            },
            "education": {
                "block_title": "education.title",
                "educations": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "EDUCATION.educations",
                    "block_format": {
                        "institution": {
                            "type": "text_input",
                            "title": "education.institution",
                            "resume_value": "institution"
                        },
                        "education_level": {
                            "type": "drop_down_list",
                            "title": "education.education_level",
                            "values": {
                                "null": "",
                                "MIDDLE": "education.level.middle",
                                "MIDDLE_SPEC": "education.level.middle_spec",
                                "UNFINISHED_UNIVERSITY": "education.level.unfinished_university",
                                "UNIVERSITY": "education.level.university",
                                "BACHELOR": "education.level.bachelor",
                                "SPECIALIST": "education.level.specialist",
                                "MASTER": "education.level.master",
                                "DOCTOR": "education.level.doctor",
                                "CANDIDATE": "education.level.candidate"
                            },
                            "resume_value": "education_level",
                            "default": "null"
                        },
                        "faculty": {
                            "type": "text_input",
                            "title": "education.faculty",
                            "resume_value": "faculty"
                        },
                        "speciality": {
                            "type": "text_input",
                            "title": "education.speciality",
                            "resume_value": "speciality"
                        },
                        "year_of_graduate": {
                            "type": "text_input",
                            "title": "education.year_of_graduate",
                            "resume_value": "year_of_graduate"
                        }
                    },
                    "add_button_title": "education.add_education"
                }
            },
            "advanced_training": {
                "block_title": "advanced_training.title",
                "trainings": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "ADVANCED_TRAINING.trainings",
                    "block_format": {
                        "course_name": {
                            "type": "text_input",
                            "title": "advanced_training.course_name",
                            "resume_value": "course_name"
                        },
                        "organization": {
                            "type": "text_input",
                            "title": "advanced_training.organization",
                            "resume_value": "organization"
                        },
                        "year_of_graduate": {
                            "type": "text_input",
                            "title": "advanced_training.year_of_graduate",
                            "resume_value": "year_of_graduate"
                        }
                    },
                    "add_button_title": "advanced_training.add_training"
                }
            },
            "languages": {
                "block_title": "languages.title",
                "languages": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "LANGUAGES.languages",
                    "block_format": {
                        "language": {
                            "type": "text_input",
                            "title": "languages.language",
                            "resume_value": "language"
                        },
                        "language_level": {
                            "type": "drop_down_list",
                            "title": "languages.language_level",
                            "values": {
                                "null": "",
                                "A1": "languages.level.a1",
                                "A2": "languages.level.a2",
                                "B1": "languages.level.b1",
                                "B2": "languages.level.b2",
                                "C1": "languages.level.c1",
                                "C2": "languages.level.c2"
                            },
                            "resume_value": "language_level",
                            "default": "null"
                        }
                    },
                    "add_button_title": "languages.add_language"
                }
            },
            "skills": {
                "block_title": "skills.title",
                "dynamic_combined_block": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "SKILLS.skills",
                    "block_format": {
                        "skill_name": {
                            "type": "text_input",
                            "title": "skills.skill_name",
                            "resume_value": "skill_name"
                        },
                        "skill_level": {
                            "type": "drop_down_list",
                            "title": "skills.skill_level",
                            "values": {
                                "null": "",
                                "BEGINNER": "skills.level.beginner",
                                "BASE": "skills.level.base",
                                "EXPERIENCED": "skills.level.experienced",
                                "PROFESSIONAL": "skills.level.professional"
                            },
                            "resume_value": "skill_level",
                            "default": "null"
                        }
                    },
                    "add_button_title": "skills.add_skill"
                }
            },
            "about": {
                "block_title": "about.title",
                "about": {
                    "type": "text_area",
                    "title": "",
                    "resume_value": "ABOUT.about"
                }
            },
            "hobbies": {
                "block_title": "hobbies.title",
                "hobbies": {
                    "type": "text_area",
                    "title": "",
                    "resume_value": "HOBBIES.hobbies"
                }
            },
            "recommendations": {
                "block_title": "recommendations.title",
                "recommendations": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "RECOMMENDATIONS.recommendations",
                    "block_format": {
                        "recommending": {
                            "type": "text_input",
                            "title": "recommendations.recommending",
                            "resume_value": "recommending"
                        },
                        "company": {
                            "type": "text_input",
                            "title": "recommendations.company",
                            "resume_value": "company"
                        },
                        "email": {
                            "type": "text_input",
                            "title": "recommendations.email",
                            "resume_value": "email"
                        },
                        "phone_number": {
                            "type": "text_input",
                            "title": "recommendations.phone_number",
                            "resume_value": "phone_number"
                        }
                    },
                    "add_button_title": "recommendations.add_recommendation"
                }
            },
            "publications": {
                "block_title": "publications.title",
                "publications": {
                    "type": "dynamic_combined_block",
                    "blocks_list": "PUBLICATIONS.publications",
                    "block_format": {
                        "publication": {
                            "type": "text_input",
                            "title": "publications.publication",
                            "resume_value": "publication"
                        },
                        "publication_date": {
                            "type": "date",
                            "fields": [
                                "month",
                                "year"
                            ],
                            "translations": "publications.publication_date",
                            "resume_value": "date"
                        }
                    },
                    "add_button_title": "publications.add_publication"
                }
            },
            "additional_info": {
                "block_title": "additional.title",
                "info": {
                    "type": "text_area",
                    "title": "",
                    "resume_value": "ADDITIONAL_INFO.additional_info"
                }
            }
        }
    },
    "templates_area": {
        "simple_template": {
            "template_name": "templates.simple_template_name",
            "image": "path/to/image/"
        }
    }
}